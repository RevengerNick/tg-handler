# Облегчённый multi-arch образ для Raspberry Pi и других устройств без браузера.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ffmpeg нужен для медиа-команд. gcc — резерв для пакетов без готового wheel.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY . .
RUN mkdir -p /app/data/sessions /app/data/files /app/data/tmp

CMD ["python", "-m", "src.main"]
