API_ID=
API_HASH=
#PHONES=номера через запятую без пробелов
PHONES=
#GEMINI_API_KEYS=ключи через запятую без пробелов
GEMINI_API_KEYS=
# По умолчанию Flash/Pro/Flash-Lite используют автообновляемые *-latest aliases.
# Эти переменные нужны только если модель требуется временно закрепить вручную.
# GEMINI_FLASH_MODEL=gemini-flash-latest
# GEMINI_FLASH_PINNED_MODEL=gemini-3.8-flash
# GEMINI_PRO_MODEL=gemini-pro-latest
# GEMINI_FLASH_LITE_MODEL=gemini-flash-lite-latest
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TRANSCRIPTION_MODEL=gemini-flash-lite-latest
# GEMINI_TTS_FLASH_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_PRO_MODEL=gemini-2.5-pro-preview-tts
YANDEX_TOKEN=
EXCHANGE_API_KEY=
MY_DOMAIN=http://localhost:8112
WEB_PORT=8112
# Локально API слушает только loopback. В Docker Compose переопределяется на 0.0.0.0
# внутри контейнера, а host port всё равно привязан к 127.0.0.1.
WEB_BIND_HOST=127.0.0.1
# true = хранить результаты команд в data/files, false = удалять после отправки
KEEP_GENERATED_FILES=true
# auto = браузер с HTTP-резервом, browser = только браузер, http = без браузера и фото
OLX_SEARCH_MODE=auto
# Проверка клиентов (секунды) и число быстрых попыток переподключения
HEALTH_CHECK_INTERVAL=30
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_DELAY=5
# При долгом отсутствии сети интервал проверок растёт, но не выше 10 минут
OFFLINE_RETRY_MAX_INTERVAL=600
# Пауза между сериями неудачных попыток подключения к Telegram
RECONNECT_COOLDOWN=600

# Companion Bot API-бот: создайте через @BotFather. Он показывает только владельцу
# кнопки выбора качества; файлы всегда отправляет userbot от вашего аккаунта.
DOWNLOAD_BOT_TOKEN=
DOWNLOAD_CONTROL_USER_ID=
DOWNLOAD_MAX_CONCURRENT=1
DOWNLOAD_JOB_TTL_SECONDS=1200
DOWNLOAD_MAX_FILES=10
DOWNLOAD_METADATA_TIMEOUT_SECONDS=60
DOWNLOAD_TIMEOUT_SECONDS=1800
# DOWNLOAD_COOKIES_DIR=data/cookies
# DOWNLOAD_JOB_DATABASE_PATH=data/download_jobs.db
# OMNIGET_PATH=/usr/local/bin/omniget

# Telegram Reader API. Реальные значения храните только в закрытом .env/secrets-файле.
TG_READER_ENABLED=true
TG_READER_DATABASE_PATH=data/telegram_reader.db
TG_HANDLER_API_TOKEN=
TG_READER_REQUIRE_CF_ACCESS=true
TG_READER_CF_CLIENT_ID=
TG_READER_CF_CLIENT_SECRET=
TG_READER_TIMEZONE=Asia/Tashkent
TG_READER_BODY_LIMIT_BYTES=262144
TG_READER_RATE_LIMIT_PER_MINUTE=60
TG_READER_RESERVATION_TTL_SECONDS=180
TG_READER_CONFIRMATION_TTL_SECONDS=300
# Полная сверка Telegram не чаще раза в минуту; защищает от FloodWait.
TG_READER_RECONCILE_MIN_INTERVAL_SECONDS=60
# Ограничение одного обхода диалогов. Непрочитанные обычно находятся наверху.
TG_READER_MAX_DIALOGS=500
